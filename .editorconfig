# Règles d'édition communes à tous les éditeurs (VS Code les applique avec l'extension EditorConfig).
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

# PHP / Symfony : 4 espaces (standard PSR-12)
[*.php]
indent_size = 4

[*.md]
trim_trailing_whitespace = false
